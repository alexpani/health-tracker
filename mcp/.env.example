# Health Tracker MCP — esempio config. Copia in `.env` e modifica.
# Il file .env effettivo NON va committato (gia' in .gitignore root).

# Bearer token che il client deve mandare in Authorization header.
# Generato con: openssl rand -hex 32
MCP_BEARER_TOKEN=CHANGE_ME_32_BYTES_HEX

# Bind del server HTTP
MCP_HOST=0.0.0.0
MCP_PORT=8765

# Postgres read-only (utente health_ro creato via scripts/grant_readonly.sql)
MCP_PG_DSN=postgresql://health_ro:CHANGE_ME_PG_PASSWORD@192.168.68.166:5432/health_tracker

# FastAPI backend (per i tool di sintesi: get_day, get_health_profile, ecc.)
MCP_API_URL=http://192.168.68.166:8000

# Safety knobs SQL
MCP_SQL_STATEMENT_TIMEOUT_MS=10000
MCP_SQL_MAX_ROWS=5000
